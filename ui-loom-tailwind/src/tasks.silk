//! The app and its tasks: `silk dev` opens it in a window and restarts it when a file in src/
//! changes (`--target web-canvas` or `web-dom` serves it as a page that reloads instead);
//! `silk build --release` builds the release program and the pages, and `--out <dir>` also
//! copies each to `<dir>/<target>/`.
import tailwind.tailwind { Tailwind }
import silkui.app { App, Framework, Target, Window, Page, Built, Running }
import silk.build.graph { Options }
import silk.build.tasks { StandardError }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskSet }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileSystem }
import silk.system.host_input { HostInput }
import silk.text.string { String }

/// The app: what it is written in and where it runs. Its program takes the project's name.
effect fn app() -> App
  ! OutOfMemoryError
  ? &mut Allocator {
  return run App.make("my-app")
    |> App.framework(Framework.loom("app"))
    |> App.stylesheet("styles/app.css")
    |> App.target(Target.window(Window { title: "My app", width: 420.0, height: 200.0 }))
    |> App.target(Target.webDom(Page { title: "My app" }))
    |> App.target(Target.webCanvas(Page { title: "My app" }))
}

union Tasks {
  Build { pub options: Options, pub out: String },
  Run { pub options: Options },
  Dev { pub options: Options },
  Plan { pub options: Options },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build and run the app")
      |> Command.variant("Build", "Build the app into build/ (--release optimizes)")
      |> Command.variant("Run", "Build the app and run it")
      |> Command.variant("Dev", "Run the app with the development tools, and update it on change")
      |> Command.variant("Plan", "Write the editor's compilation requests")
      |> Command.flatten("options")
      |> Command.option("out", Opt.about("Also copy the app to this directory"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! StandardError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    let processor = Tailwind.make("styles/input.css", "styles/app.css")
    match move self {
      Tasks.Build { options, out } => {
        drop run processor.build()
        run app() |> App.build(&options) |> Built.write(out.view())
      }
      Tasks.Run { options } => {
        drop run processor.build()
        run app() |> App.build(&options) |> Built.launch() |> Running.watch()
      }
      Tasks.Dev { options } => run processor.watching(app()
        |> App.dev(&options)
        |> Built.launch()
        |> Running.watch())
      Tasks.Plan { options } => {
        drop run processor.build()
        let graph = run (run app()).compilations(&options)
        drop run graph.write()
      }
    }
  }
}

pub effect fn main() -> i32
  ? &mut HostInput {
  return run Task.main<Tasks>()
}
