//! `silk run` starts `silk task dev`; arguments after `--` go to it, such as
//! `silk run -- --target web-dom`.
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }

effect fn dev() -> i32 ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let given = run HostInput.arguments()
  let mut words = List<Bytes>.make()
  run words.append(run Bytes.copy(b"task"))
  run words.append(run Bytes.copy(b"dev"))
  let all = given.asSlice()
  let mut at: usize = 1
  while at < all.length {
    run words.append(run Bytes.copy(Bytes.asSlice(&all[at])))
    at = at + 1
  }
  let mut files = run MachineFileSystem.make()
  let outcome = run Effect.result(Task.execBytes(b"silk", words.asSlice())) |> Effect.provideMut<FileSystem>(&mut files)
  return match move outcome {
    Result.Success { .. } => 0
    Result.Failure { error } => match move error {
      TaskError failure => failure.status
      HostInputError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let outcome = run Effect.result(dev()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move outcome {
    Result.Success { value } => value
    Result.Failure { error } => {
      drop error
      1
    }
  }
}
