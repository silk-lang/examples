//! The app and its tasks: `silk task dev` opens it in a window, and Vite replaces the modules
//! an edit touches; `silk task build` writes the release program, bundle inside, to dist/window/.
import silkui.app { App, Framework, Target, Window, Mode, Built, Running }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

/// The app: what it is written in and where it runs. Its name names the program in dist/.
effect fn app() -> App ! OutOfMemoryError ? &mut Allocator {
  return run App.make("my-app")
    |> App.framework(Framework.foldkit("web"))
    |> App.target(Target.window(Window { title: "My app", width: 420.0, height: 200.0 }))
    // JavaScript apps run in a window for now; web-canvas is next.
}

union Tasks {
  Dev { pub target: String },
  Build { pub target: String },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "Build and run the app")
      |> Command.variant("Dev", "Open the app with the development tools, rebuilding on change")
      |> Command.variant("Build", "Write the release programs to dist/<target>/")
      |> Command.option("target", Opt.about("Only this target (window)"))
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError | ProcessError | FileError | HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Dev { target } => run app()
        |> App.only(String.view(&target))
        |> App.build(Mode.Dev)
        |> Built.launch()
        |> Running.watch()
      Tasks.Build { target } => run app()
        |> App.only(String.view(&target))
        |> App.build(Mode.Release)
        |> Built.tap(Built.sizes)
        |> Built.write("dist")
    }
  }
}

pub effect fn main() -> i32 ? &mut HostInput { return run Task.main<Tasks>() }
